# Chạy payment ngoài Docker (npm run start:dev), hạ tầng từ `make up`.
PORT=3001
DATABASE_URL=postgresql://app:app@localhost:5440/payment_db
KAFKA_BROKERS=localhost:19092
# chỉ dùng cho môi trường dev; cổng giả lập ký và webhook xác minh bằng cùng secret
WEBHOOK_SECRET=dev-only-webhook-secret-0123456789abcdef
LOG_LEVEL=debug
