generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  draft
  published

  @@map("event_status")
}

model Venue {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  events    Event[]

  @@map("venues")
}

// Event chỉ sửa sơ đồ ghế khi còn draft. Publish khóa sơ đồ ghế và đẩy danh sách ghế sang inventory.
model Event {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  description String       @default("")
  venueId     String       @map("venue_id") @db.Uuid
  startsAt    DateTime     @map("starts_at") @db.Timestamptz
  status      EventStatus  @default(draft)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Restrict)
  tiers       TicketTier[]
  seats       Seat[]

  // ListEvents phân trang keyset theo (starts_at, id), có lọc status
  @@index([status, startsAt, id])
  @@index([startsAt, id])
  @@index([venueId])
  @@map("events")
}

model TicketTier {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String
  // đơn vị tiền nhỏ nhất (VND: đồng)
  priceAmount BigInt   @map("price_amount")
  currency    String   @db.Char(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seats       Seat[]

  @@unique([eventId, name])
  @@map("ticket_tiers")
}

model Seat {
  // id sinh trong Postgres vì GenerateSeats insert hàng loạt bằng generate_series
  id      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId String     @map("event_id") @db.Uuid
  tierId  String     @map("tier_id") @db.Uuid
  section String
  row     String
  number  Int
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tier    TicketTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@unique([eventId, section, row, number])
  @@index([tierId])
  @@map("seats")
}
